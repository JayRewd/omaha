				<button width="100%" height="fill"
				        fill="{var.fill-transparent}" hoverfill="{var.fill-pause-hover}"
				        color="{var.fill-transparent}" font="control" font-size="1px">
					<on event="focus">
						<set-cvar name="ui_weaponsign" value="{item.field.sign}"/>
					</on>
					<on event="click">
						<set-cvar name="ui_om_cbuf" value="{item.field.cmd}"/>
						<invoke name="cbuf"/>
					</on>
				</button>
			</template>
			<template id="pause-vote-row">
				<button width="100%" height="32px" padding="0 8px"
				        fill="{var.fill-transparent}" hoverfill="{var.fill-pause-hover}"
				        color="{var.color-pause-gold}" font="control" font-size="{var.text-control}"
				        halign="start" valign="center">
					{item.label}
					<on event="click">
						<set-cvar name="ui_om_cbuf" value="{item.field.cmd}"/>
						<invoke name="cbuf"/>
					</on>
				</button>
			</template>
		</templates>
