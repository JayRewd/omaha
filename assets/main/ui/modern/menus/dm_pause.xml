<ui version="1">
	<!--
		Added in OPM: classic HUD MP pause — full modern XML tree (no UIFAKK).
		Stage = full canvas as 640×480 virtual space (same stretch as retail virtualres).
		Author coords as % of that stage (URC /640 and /480). Base escmenu + team/weapon art.
	-->
