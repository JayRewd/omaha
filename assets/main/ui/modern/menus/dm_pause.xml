			</container>

			<!-- ========== VOTE CALL / SUB ========== -->
			<container type="vertical" width="52.5%" height="auto" gap="0"
			           margin="15% 0 0 23.75%" fill="{var.fill-pause-panel}"
			           visible="{cvar.ui_om_pause_panel == vote_call or cvar.ui_om_pause_panel == vote_sub}">
				<label width="100%" height="24px" padding="0 8px" fill="{var.fill-pause-header}"
				       color="{var.color-pause-gold}" font="control" font-size="{var.text-control}" valign="center"
				       visible="{cvar.ui_om_pause_panel == vote_call}">Select the vote to call</label>
				<label width="100%" height="24px" padding="0 8px" fill="{var.fill-pause-header}"
				       color="{var.color-pause-gold}" font="control" font-size="{var.text-control}" valign="center"
				       visible="{cvar.ui_om_pause_panel == vote_sub}"
				       bind="cvar:ui_votesubtitle">{cvar.ui_votesubtitle}</label>
				<container type="vertical" width="100%" height="auto" gap="0" padding="8px"
				           source="vote-options" fill="{var.fill-transparent}">
					<foreach mode="all">
						<use template="pause-vote-row"/>
					</foreach>
				</container>
				<button width="100%" height="32px" padding="0 8px"
				        fill="{var.fill-pause-button}" hoverfill="{var.fill-pause-hover}"
				        color="{var.color-pause-gold}" font="control" font-size="{var.text-body}">
					Back
					<on event="click">
						<set-cvar name="ui_om_cbuf" value="set ui_om_pause_panel root"/>
						<invoke name="cbuf"/>
					</on>
				</button>
			</container>

			<!-- ========== VOTE ENTRY ========== -->
			<container type="vertical" width="52.5%" height="auto" gap="8px" padding="12px"
			           margin="20% 0 0 23.75%" fill="{var.fill-pause-panel}"
			           visible="{cvar.ui_om_pause_panel == vote_entry}">
				<label width="100%" height="24px" color="{var.color-pause-gold}" font="control" font-size="{var.text-control}"
				       bind="cvar:ui_votesubtitle">{cvar.ui_votesubtitle}</label>
				<input type="text" width="100%" height="auto" padding="8px"
				       bind="cvar:ui_votestringentry" commit="change" max-length="64"
				       fill="{var.fill-input}" color="{var.color-pause-gold}" font="body" font-size="{var.text-body}"/>
				<button width="100%" height="32px" fill="{var.fill-pause-button-strong}" hoverfill="{var.fill-pause-hover-chip}"
				        color="{var.color-pause-gold}" font="control" font-size="{var.text-body}">
					Submit Vote
					<on event="click">
						<set-cvar name="ui_om_cbuf" value="callentryvote;ui_close menu dm_pause"/>
						<invoke name="cbuf"/>
					</on>
				</button>
				<button width="100%" height="32px" fill="{var.fill-pause-button}" hoverfill="{var.fill-pause-hover}"
				        color="{var.color-pause-gold}" font="control" font-size="{var.text-body}">
					Back
					<on event="click">
						<set-cvar name="ui_om_cbuf" value="pushcallvote"/>
						<invoke name="cbuf"/>
					</on>
				</button>
			</container>

			<!-- ========== VOTE CAST ========== -->
			<container type="vertical" width="52.5%" height="auto" gap="8px" padding="12px"
			           margin="25% 0 0 23.75%" fill="{var.fill-pause-panel-alt}"
			           visible="{cvar.ui_om_pause_panel == vote_cast}">
				<label width="100%" height="24px" color="{var.color-pause-gold}" font="control" font-size="{var.text-control}"
				       bind="cvar:ui_votesubtitle">{cvar.ui_votesubtitle}</label>
				<label width="100%" color="{var.color-pause-gold}" font="control" font-size="{var.text-body}">Cast your vote:</label>
				<container type="horizontal" width="100%" height="auto" gap="8px" source="pause-vote-cast">
					<foreach mode="all" type="horizontal" width="100%" height="auto" gap="8px">
						<button width="fill" height="32px"
						        fill="{var.fill-pause-button-strong}" hoverfill="{var.fill-pause-hover-chip}"
						        color="{var.color-pause-gold}" font="control" font-size="{var.text-body}"
						        halign="center" valign="center">
							{item.label}
							<on event="click">
								<set-cvar name="ui_om_cbuf" value="{item.field.cmd}"/>
								<invoke name="cbuf"/>
							</on>
						</button>
					</foreach>
				</container>
			</container>

		</container>
	</canvas>
</ui>
