<ui version="1">
	<!--
		Added in OPM: modern HUD MP pause shell — main-menu styling, no retail art/models.
		Panel router: ui_om_pause_panel (root | team | weapon | vote_*).
	-->
	<definitions menu-id="dm_pause_modern" draw-order="7">
		<import src="ui/modern/lib/theme.xml"/>
		<import src="ui/modern/lib/shapes.xml"/>
		<import src="ui/modern/lib/controls.xml"/>
		<import src="ui/modern/lib/sources.xml"/>
		<import src="ui/modern/lib/pause_modern.xml"/>
	</definitions>
	<canvas pointer="1">
		<container id="pause_root" type="overlap" width="100%" height="100%" fill="{var.fill-scrim}">

			<!-- Dismiss: resume when root panel is showing -->
			<button width="100%" height="100%" fill="{var.fill-transparent}" color="{var.fill-transparent}"
			        visible="{cvar.ui_om_pause_panel == root}">
				<on event="click">
					<set-cvar name="ui_om_cbuf" value="ui_close menu dm_pause"/>
					<invoke name="cbuf"/>
				</on>
			</button>

			<!-- ========== ROOT ========== -->
			<container id="pause_root_panel" type="vertical" width="400px" height="auto" gap="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px"
			           visible="{cvar.ui_om_pause_panel == root}">
				<use template="pause-modern-panel-header" title="MENU"/>
				<container type="vertical" width="100%" height="auto" gap="8px" padding="16px">
					<button width="100%" height="40px" padding="0 20px 0 26px"
							fill="{var.fill-control}" hoverfill="{var.color-accent}"
							color="{var.color-white}" font="control" font-size="{var.text-control}"
							letter-spacing="2px" halign="start" valign="center">
						MAIN MENU
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="ui_close menu dm_pause;set ui_om_main_panel settings;pushmenu main"/>
							<invoke name="cbuf"/>
						</on>
					</button>
					<button width="100%" height="40px" padding="0 20px 0 26px"
					        fill="{var.fill-control}" hoverfill="{var.color-accent}"
					        color="{var.color-white}" font="control" font-size="{var.text-control}"
					        letter-spacing="2px" halign="start" valign="center">
						CHANGE TEAM
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="set ui_om_pause_panel team"/>
							<invoke name="cbuf"/>
						</on>
					</button>
					<button width="100%" height="40px" padding="0 20px 0 26px"
					        fill="{var.fill-control}" hoverfill="{var.color-accent}"
					        color="{var.color-white}" font="control" font-size="{var.text-control}"
					        letter-spacing="2px" halign="start" valign="center">
						CHANGE WEAPON
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="set ui_om_pause_panel weapon"/>
							<invoke name="cbuf"/>
						</on>
					</button>
					<button width="100%" height="40px" padding="0 20px 0 26px"
					        fill="{var.fill-control}" hoverfill="{var.color-accent}"
					        color="{var.color-white}" font="control" font-size="{var.text-control}"
					        letter-spacing="2px" halign="start" valign="center">
						SPECTATE
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="spectator;ui_close menu dm_pause"/>
							<invoke name="cbuf"/>
						</on>
					</button>
				</container>
			</container>

			<!-- ========== TEAM ========== -->
			<container id="pause_team_panel" type="vertical" width="560px" height="auto" gap="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px"
			           visible="{cvar.ui_om_pause_panel == team}">
				<use template="pause-modern-panel-header" title="CHANGE TEAM"/>
				<container type="vertical" width="100%" height="auto" gap="12px" padding="16px">
					<container type="horizontal" width="100%" height="auto" gap="12px">
						<container type="vertical" width="fill" height="auto" gap="0">
							<use template="pause-modern-team-card" title="ALLIES" color="{var.color-allied}"/>
							<button id="pause_team_allies" width="100%" height="40px" margin="8px 0 0 0"
							        fill="{var.color-accent}" hoverfill="{var.color-accent-hover}"
							        color="{var.color-white}" font="control" font-size="{var.text-control}"
							        letter-spacing="2px" halign="center" valign="center">
								JOIN ALLIES
								<on event="click">
									<set-cvar name="ui_om_cbuf" value="join_team allies;ui_close menu dm_pause"/>
									<invoke name="cbuf"/>
								</on>
							</button>
						</container>
						<container type="vertical" width="fill" height="auto" gap="0">
							<use template="pause-modern-team-card" title="AXIS" color="{var.color-axis}"/>
							<button id="pause_team_axis" width="100%" height="40px" margin="8px 0 0 0"
							        fill="{var.color-accent}" hoverfill="{var.color-accent-hover}"
							        color="{var.color-white}" font="control" font-size="{var.text-control}"
							        letter-spacing="2px" halign="center" valign="center">
								JOIN AXIS
								<on event="click">
									<set-cvar name="ui_om_cbuf" value="join_team axis;ui_close menu dm_pause"/>
									<invoke name="cbuf"/>
								</on>
							</button>
						</container>
					</container>

					<container type="vertical" width="100%" height="auto" gap="4px" padding="8px 0 0 0"
					           visible="{cvar.cg_gametype == 4}">
						<label font="control" font-size="{var.text-caption}" color="{var.color-muted}"
						       letter-spacing="1px">OBJECTIVES</label>
						<container type="horizontal" width="100%" height="auto" gap="12px">
							<container type="vertical" width="fill" height="auto" gap="2px">
								<label font="body" font-size="{var.text-body}" color="{var.color-allied}"
								       bind="cvar:cg_obj_alliedtext1">{cvar.cg_obj_alliedtext1}</label>
								<label font="body" font-size="{var.text-body}" color="{var.color-allied}"
								       bind="cvar:cg_obj_alliedtext2">{cvar.cg_obj_alliedtext2}</label>
								<label font="body" font-size="{var.text-body}" color="{var.color-allied}"
								       bind="cvar:cg_obj_alliedtext3">{cvar.cg_obj_alliedtext3}</label>
							</container>
							<container type="vertical" width="fill" height="auto" gap="2px">
								<label font="body" font-size="{var.text-body}" color="{var.color-axis}"
								       bind="cvar:cg_obj_axistext1">{cvar.cg_obj_axistext1}</label>
								<label font="body" font-size="{var.text-body}" color="{var.color-axis}"
								       bind="cvar:cg_obj_axistext2">{cvar.cg_obj_axistext2}</label>
								<label font="body" font-size="{var.text-body}" color="{var.color-axis}"
								       bind="cvar:cg_obj_axistext3">{cvar.cg_obj_axistext3}</label>
							</container>
						</container>
					</container>

					<container type="horizontal" width="100%" height="auto" gap="8px" padding="8px 0 0 0">
						<button width="fill" height="36px"
						        fill="{var.fill-control}" hoverfill="{var.color-accent}"
						        color="{var.color-white}" font="control" font-size="{var.text-body}"
						        halign="center" valign="center">
							AUTO
							<on event="click">
								<set-cvar name="ui_om_cbuf" value="auto_join_team;ui_close menu dm_pause"/>
								<invoke name="cbuf"/>
							</on>
						</button>
						<button width="fill" height="36px"
						        fill="{var.fill-transparent}" hoverfill="{var.fill-hover-ghost}"
						        color="{var.color-muted}" font="control" font-size="{var.text-body}"
						        halign="center" valign="center">
							BACK
							<on event="click">
								<set-cvar name="ui_om_cbuf" value="set ui_om_pause_panel root"/>
								<invoke name="cbuf"/>
							</on>
						</button>
					</container>
				</container>
			</container>

			<!-- ========== WEAPON ========== -->
			<container id="pause_weapon_panel" type="vertical" width="400px" height="auto" gap="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px"
			           visible="{cvar.ui_om_pause_panel == weapon}">
				<use template="pause-modern-panel-header" title="CHANGE WEAPON"/>
				<container type="vertical" width="100%" height="auto" gap="0" padding="8px 0"
				           source="pause-weapons" fill="{var.fill-transparent}">
					<foreach mode="all" type="vertical" width="100%" height="auto" gap="0">
						<use template="pause-modern-weapon-row"/>
					</foreach>
				</container>
				<container width="100%" height="1px" fill="{var.fill-divider}"/>
				<container width="100%" height="auto" padding="12px 16px">
					<button width="100%" height="36px" padding="0 16px"
					        fill="{var.fill-transparent}" hoverfill="{var.fill-hover-ghost}"
					        color="{var.color-muted}" font="control" font-size="{var.text-body}"
					        letter-spacing="1px" halign="center" valign="center">
						BACK
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="set ui_om_pause_panel root"/>
							<invoke name="cbuf"/>
						</on>
					</button>
				</container>
			</container>

			<!-- ========== VOTE CALL / SUB ========== -->
			<container type="vertical" width="480px" height="auto" gap="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px"
			           visible="{cvar.ui_om_pause_panel == vote_call or cvar.ui_om_pause_panel == vote_sub}">
				<container type="vertical" width="100%" height="48px" gap="0">
					<container width="100%" height="fill" fill="{var.fill-input}" padding="0 16px" valign="center">
						<label font="control" font-size="{var.text-heading}" color="{var.color-white}"
						       letter-spacing="2px" halign="start"
						       visible="{cvar.ui_om_pause_panel == vote_call}">CALL VOTE</label>
						<label font="control" font-size="{var.text-heading}" color="{var.color-white}"
						       letter-spacing="2px" halign="start"
						       visible="{cvar.ui_om_pause_panel == vote_sub}"
						       bind="cvar:ui_votesubtitle">{cvar.ui_votesubtitle}</label>
					</container>
					<container width="100%" height="1px" fill="{var.fill-divider}"/>
				</container>
				<container type="vertical" width="100%" height="auto" gap="0" padding="8px 0"
				           source="vote-options" fill="{var.fill-transparent}">
					<foreach mode="all">
						<use template="pause-modern-vote-row"/>
					</foreach>
				</container>
				<container width="100%" height="auto" padding="12px 16px">
					<button width="100%" height="36px" padding="0 16px"
					        fill="{var.fill-transparent}" hoverfill="{var.fill-hover-ghost}"
					        color="{var.color-muted}" font="control" font-size="{var.text-body}"
					        letter-spacing="1px" halign="center" valign="center">
						BACK
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="set ui_om_pause_panel root"/>
							<invoke name="cbuf"/>
						</on>
					</button>
				</container>
			</container>

			<!-- ========== VOTE ENTRY ========== -->
			<container type="vertical" width="480px" height="auto" gap="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px"
			           visible="{cvar.ui_om_pause_panel == vote_entry}">
				<use template="pause-modern-panel-header" title="VOTE"/>
				<container type="vertical" width="100%" height="auto" gap="12px" padding="16px">
					<label width="100%" color="{var.color-muted}" font="control" font-size="{var.text-body}"
					       bind="cvar:ui_votesubtitle">{cvar.ui_votesubtitle}</label>
					<input type="text" width="100%" height="auto" padding="8px"
					       bind="cvar:ui_votestringentry" commit="change" max-length="64"
					       fill="{var.fill-input}" color="{var.color-white}" font="body" font-size="{var.text-body}"/>
					<button width="100%" height="40px" padding="0 20px 0 26px"
					        fill="{var.color-accent}" hoverfill="{var.color-accent-hover}"
					        color="{var.color-white}" font="control" font-size="{var.text-control}"
					        letter-spacing="2px" halign="center" valign="center">
						SUBMIT VOTE
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="callentryvote;ui_close menu dm_pause"/>
							<invoke name="cbuf"/>
						</on>
					</button>
					<button width="100%" height="36px" padding="0 16px"
					        fill="{var.fill-transparent}" hoverfill="{var.fill-hover-ghost}"
					        color="{var.color-muted}" font="control" font-size="{var.text-body}"
					        letter-spacing="1px" halign="center" valign="center">
						BACK
						<on event="click">
							<set-cvar name="ui_om_cbuf" value="pushcallvote"/>
							<invoke name="cbuf"/>
						</on>
					</button>
				</container>
			</container>

			<!-- ========== VOTE CAST ========== -->
			<container type="vertical" width="400px" height="auto" gap="0"
			           halign="center" valign="center"
			           fill="{var.fill-panel}" stroke="{var.fill-divider}" stroke-width="1px"
			           visible="{cvar.ui_om_pause_panel == vote_cast}">
				<use template="pause-modern-panel-header" title="CAST VOTE"/>
				<container type="vertical" width="100%" height="auto" gap="12px" padding="16px">
					<label width="100%" color="{var.color-muted}" font="control" font-size="{var.text-body}"
					       bind="cvar:ui_votesubtitle">{cvar.ui_votesubtitle}</label>
					<label width="100%" color="{var.color-primary}" font="control" font-size="{var.text-body}">Cast your vote:</label>
					<container type="horizontal" width="100%" height="auto" gap="8px" source="pause-vote-cast">
						<foreach mode="all" type="horizontal" width="100%" height="auto" gap="8px">
							<button width="fill" height="40px"
							        fill="{var.color-accent}" hoverfill="{var.color-accent-hover}"
							        color="{var.color-white}" font="control" font-size="{var.text-control}"
							        letter-spacing="2px" halign="center" valign="center">
								{item.label}
								<on event="click">
									<set-cvar name="ui_om_cbuf" value="{item.field.cmd}"/>
									<invoke name="cbuf"/>
								</on>
							</button>
						</foreach>
					</container>
				</container>
			</container>

		</container>
	</canvas>
</ui>
