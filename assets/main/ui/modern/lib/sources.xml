<ui-library version="1">
	<sources>
		<source id="screen-catalog" default="main">
			<item value="main" label="Main Menu" file="ui/modern/main.xml"/>
			<item value="layout-lab" label="Layout Lab" file="ui/modern/examples/layout_lab.xml"/>
			<item value="layout-lab-nested" label="Nested Lab" file="ui/modern/examples/layout_lab_nested.xml"/>
		</source>

		<source id="menu-panels" default="play">
			<item value="play" label="PLAY" panel="panel_play"/>
			<item value="settings" label="SETTINGS" panel="panel_settings"/>
		</source>

		<source id="settings-pages" default="input">
			<item value="input" label="INPUT" template="settings-page-input"/>
			<item value="video" label="VIDEO" template="settings-page-video"/>
			<item value="audio" label="AUDIO" template="settings-page-audio"/>
			<item value="gameplay" label="GAMEPLAY" template="settings-page-gameplay"/>
		</source>

		<source id="browser-gametypes" default="">
			<item value="" label="ALL"/>
			<item value="FFA" label="FFA"/>
			<item value="TDM" label="TDM"/>
			<item value="Objective" label="OBJECTIVE"/>
			<item value="Round" label="ROUNDS"/>
			<item value="Other" label="OTHER"/>
		</source>

		<source id="display-mode" default="1">
			<item value="1" label="Fullscreen"/>
			<item value="2" label="Borderless"/>
			<item value="0" label="Windowed"/>
		</source>

		<!-- display-refresh is host-backed (SDL modes); see docs/research/display-refresh-sources.md -->

		<source id="max-fps" default="125">
			<item value="125" label="125"/>
			<item value="250" label="250"/>
			<item value="500" label="500"/>
		</source>

		<source id="color-depth" default="32">
			<item value="16" label="16-bit"/>
			<item value="32" label="32-bit"/>
		</source>

		<source id="texture-depth" default="32">
			<item value="16" label="16-bit"/>
			<item value="32" label="32-bit"/>
		</source>

		<source id="speaker-setup" default="0">
			<item value="0" label="Two Speakers"/>
			<item value="1" label="Headphones"/>
			<item value="2" label="Surround (5.1)"/>
			<item value="3" label="Quad Speakers"/>
		</source>

		<source id="sample-rate" default="44">
			<item value="11" label="11 kHz"/>
			<item value="22" label="22 kHz"/>
			<item value="44" label="44 kHz"/>
		</source>

		<source id="miles-driver" default="auto">
			<item value="auto" label="Auto"/>
			<item value="DirectSound3D Hardware Support" label="DirectSound3D"/>
			<item value="Creative Labs EAX 2 (TM)" label="Creative EAX 2"/>
			<item value="Creative Labs EAX (TM)" label="Creative EAX"/>
			<item value="Aureal A3D 2.0 (TM)" label="Aureal A3D 2.0"/>
			<item value="Dolby Surround" label="Dolby Surround"/>
			<item value="Miles Fast 2D Positional Audio" label="2D Positional"/>
		</source>

		<source id="picmip" default="1">
			<item value="0" label="Highest (0)"/>
			<item value="1" label="High (1)"/>
			<item value="2" label="Medium (2)"/>
			<item value="3" label="Low (3)"/>
		</source>

		<source id="texture-filter" default="GL_LINEAR_MIPMAP_LINEAR">
			<item value="GL_NEAREST" label="Nearest"/>
			<item value="GL_LINEAR" label="Linear"/>
			<item value="GL_NEAREST_MIPMAP_NEAREST" label="Nearest mipmap"/>
			<item value="GL_LINEAR_MIPMAP_NEAREST" label="Bilinear"/>
			<item value="GL_LINEAR_MIPMAP_LINEAR" label="Trilinear"/>
		</source>

		<source id="shadows" default="1">
			<item value="0" label="Off"/>
			<item value="1" label="Mode 1"/>
			<item value="2" label="Mode 2"/>
			<item value="3" label="Mode 3"/>
		</source>

		<source id="effect-detail" default="1.0">
			<item value="0.2" label="Low"/>
			<item value="0.6" label="Medium"/>
			<item value="1.0" label="High"/>
		</source>

		<source id="lod-scale" default="1.1">
			<item value="0.5" label="Performance"/>
			<item value="1.1" label="Balanced"/>
			<item value="1.5" label="High Detail"/>
		</source>

		<source id="crosshair-shape" default="open">
			<item value="none" label="None"/>
			<item value="open" label="Cross"/>
			<item value="solid" label="Solid"/>
			<item value="dot" label="Dot"/>
		</source>

		<!-- Added in OPM: zoom mouse scale mode (modern UI). -->
		<source id="zoom-sensitivity-mode" default="screen">
			<item value="off" label="Off"/>
			<item value="legacy" label="Legacy"/>
			<item value="screen" label="Screen distance"/>
		</source>

		<source id="crosshair-mode" default="open">
			<item value="none" label="None"/>
			<item value="solid" label="Solid"/>
			<item value="open" label="Open"/>
			<item value="dot" label="Dot"/>
		</source>

		<source id="crosshair-color" default="5">
			<item value="0" label="Green"/>
			<item value="1" label="Yellow"/>
			<item value="2" label="Blue"/>
			<item value="3" label="Cyan"/>
			<item value="4" label="Red"/>
			<item value="5" label="Custom"/>
		</source>

		<source id="crosshair-style" default="open">
			<item value="none" label="None"/>
			<item value="solid" label="Solid"/>
			<item value="open" label="Open"/>
			<item value="dot" label="Dot"/>
		</source>

		<source id="draw-viewmodel" default="2">
			<item value="0" label="Off"/>
			<item value="1" label="Weapon only"/>
			<item value="2" label="Weapon and hands"/>
		</source>

		<source id="weapons-bar" default="1">
			<item value="0" label="Off"/>
			<item value="1" label="On"/>
			<item value="2" label="Fade"/>
		</source>

