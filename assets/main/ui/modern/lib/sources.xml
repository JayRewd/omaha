		<!-- Added in OPM: classic dm_pause hit catalogs (cmd → cbuf; labels required). -->
		<source id="pause-weapons">
			<item value="rifle" label="Rifle" cmd="primarydmweapon rifle;ui_close menu dm_pause" sign="rifle_sign"/>
			<item value="sniper" label="Sniper Rifle" cmd="primarydmweapon sniper;ui_close menu dm_pause" sign="sniperrifle_sign"/>
			<item value="smg" label="Sub-Machinegun" cmd="primarydmweapon smg;ui_close menu dm_pause" sign="submachinegun_sign"/>
			<item value="mg" label="Machinegun" cmd="primarydmweapon mg;ui_close menu dm_pause" sign="machinegun_sign"/>
			<item value="heavy" label="Rocket Launcher" cmd="primarydmweapon heavy;ui_close menu dm_pause" sign="rocketlauncher_sign"/>
			<item value="shotgun" label="Shotgun" cmd="primarydmweapon shotgun;ui_close menu dm_pause" sign="shotgun_sign"/>
		</source>

		<source id="pause-vote-cast">
			<item value="yes" label="Yes" cmd="vote 1;ui_close menu dm_pause"/>
			<item value="no" label="No" cmd="vote 0;ui_close menu dm_pause"/>
		</source>
